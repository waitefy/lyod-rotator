+
+// A transient 429 may explicitly permit an immediate retry. Do not turn it into
+// an invented one-hour quota window; retain a one-second minimum backoff.
+fn retry_after_reset(header: Option<&wreq::header::HeaderValue>, now: i64) -> Option<i64> {
+    let seconds = header?.to_str().ok()?.trim().parse::<u64>().ok()?;
+    now.checked_add(i64::try_from(seconds.max(1)).ok()?)
+}
+
+#[cfg(test)]
+mod lyod_rate_limit_tests {
+    use super::retry_after_reset;
+    use wreq::header::HeaderValue;
+
+    #[test]
+    fn honors_explicit_retry_after_without_inventing_an_hour() {
+        assert_eq!(retry_after_reset(Some(&HeaderValue::from_static("0")), 100), Some(101));
+        assert_eq!(retry_after_reset(Some(&HeaderValue::from_static("17")), 100), Some(117));
+        let response = super::ClewdrError::InvalidCookie {
+            reason: crate::config::Reason::TooManyRequest(chrono::Utc::now().timestamp() + 17),
+        };
+        let response = axum::response::IntoResponse::into_response(response);
+        assert_eq!(response.status(), wreq::StatusCode::TOO_MANY_REQUESTS);
+        assert!(response.headers().contains_key("retry-after"));
+        assert_eq!(retry_after_reset(None, 100), None);
+        assert_eq!(retry_after_reset(Some(&HeaderValue::from_static("invalid")), 100), None);
+        assert_eq!(retry_after_reset(Some(&HeaderValue::from_static("-1")), 100), None);
+        assert_eq!(retry_after_reset(Some(&HeaderValue::from_static("18446744073709551615")), 100), None);
+    }
+}
