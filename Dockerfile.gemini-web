FROM golang:1.27.2-bookworm AS go-toolchain
FROM node:22-bookworm-slim AS engine-build
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}" CGO_ENABLED=0 ROTATOR_ENGINE_TEST=1
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY gemini-engine.json ./
COPY third_party/gemini-sentinel ./third_party/gemini-sentinel
RUN cd third_party/gemini-sentinel && go mod download
COPY engines/gemini-web ./engines/gemini-web
COPY scripts/build-gemini-engine.mjs scripts/gemini-engine-source.mjs ./scripts/
RUN node scripts/build-gemini-engine.mjs /out/rotator-gemini-engine

FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-gemini-web.txt fork-base.json ./
RUN python3 -m venv /opt/gemini-web \
    && /opt/gemini-web/bin/pip install --no-cache-dir -r requirements-gemini-web.txt
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=engine-build /out/rotator-gemini-engine /usr/local/bin/rotator-gemini-engine
COPY gemini-engine.json ./
COPY third_party/gemini-sentinel/LICENSE /usr/share/doc/rotator-gemini-engine/LICENSE
COPY --chown=node:node bin ./bin
COPY --chown=node:node src ./src
COPY --chown=node:node README.md CHANGELOG.md LICENSE ./
ARG ROTATOR_VERSION=unknown
ARG VCS_REF=unknown
ARG VCS_URL=local
ARG SOURCE_STATE=unknown
LABEL org.opencontainers.image.title="Lyod Rotator" \
    org.opencontainers.image.version=$ROTATOR_VERSION \
    org.opencontainers.image.revision=$VCS_REF \
    org.opencontainers.image.source=$VCS_URL
RUN node --input-type=module -e '\
    import { readFileSync, writeFileSync } from "node:fs"; \
    const upstream = JSON.parse(readFileSync("fork-base.json", "utf8")); \
    const version = JSON.parse(readFileSync("package.json", "utf8")).version; \
    const pinned = readFileSync("requirements-gemini-web.txt", "utf8").match(/gemini-webapi\s*@\s*git\+([^\s]+)@([a-f0-9]{40})/); \
    if (!pinned) throw new Error("Gemini Web client must be pinned to a commit"); \
    if (process.env.ROTATOR_VERSION !== "unknown" && process.env.ROTATOR_VERSION !== version) throw new Error("Image version differs from package.json"); \
    const geminiEngine = JSON.parse(readFileSync("gemini-engine.json", "utf8")).engine; \
    writeFileSync("build-info.json", JSON.stringify({ version, upstream, source: { commit: process.env.VCS_REF, repository: process.env.VCS_URL, state: process.env.SOURCE_STATE }, geminiEngine, geminiWebapi: { repository: pinned[1], commit: pinned[2] } }, null, 2) + "\n");'
RUN mkdir -p /data /sessions && chown -R node:node /app /data /sessions
USER node
ENV NODE_ENV=production \
    TUXEVIL_ROTATOR_DIR=/data \
    TUXEVIL_ROTATOR_CONTAINER=1 \
    TUXEVIL_ROTATOR_GEMINI_WEB_PYTHON=/opt/gemini-web/bin/python
EXPOSE 51200
VOLUME ["/data", "/sessions"]
CMD ["node", "--import", "tsx/esm", "src/cli.ts", "start"]
